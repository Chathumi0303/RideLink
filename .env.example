# ===================================================================
# RideLink - Ride Management Service Environment Configuration
# Copy this file to .env or export these variables in your environment.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR CREDENTIALS TO SOURCE CONTROL!
# ===================================================================

# Service Port
PORT=8083

# MongoDB Connection String (must point to ride_management_db, independent from other services)
MONGODB_URI=mongodb://localhost:27017/ride_management_db

# JWT Symmetric Secret Key (minimum 256 bits for HMAC-SHA256)
# Provided by Account Service or shared secret for token verification
JWT_SECRET_KEY=ridelink-super-secret-jwt-signing-key-for-development-and-evaluation-purposes-must-be-at-least-256-bits!

# Driver & Vehicle Service Base URL (Port 8082)
DRIVER_SERVICE_BASE_URL=http://localhost:8082
DRIVER_SERVICE_CONNECT_TIMEOUT_MS=3000
DRIVER_SERVICE_READ_TIMEOUT_MS=5000

# Fare & Payment Service Base URL (Port 8084)
FARE_PAYMENT_SERVICE_BASE_URL=http://localhost:8084
FARE_PAYMENT_SERVICE_CONNECT_TIMEOUT_MS=3000
FARE_PAYMENT_SERVICE_READ_TIMEOUT_MS=5000
