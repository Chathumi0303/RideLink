{
  "info": {
    "name": "RideLink - Fare & Payment Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8084"},
    {"key": "token", "value": ""},
    {"key": "rideId", "value": "11111111-1111-1111-1111-111111111111"}
  ],
  "item": [
    {
      "name": "Estimate Fare",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {"mode": "raw", "raw": "{\"distanceKm\":5,\"durationMinutes\":10}"},
        "url": "{{baseUrl}}/api/fares/estimate"
      }
    },
    {
      "name": "Create Final Fare",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {"mode": "raw", "raw": "{\"rideId\":\"{{rideId}}\",\"distanceKm\":5,\"durationMinutes\":10}"},
        "url": "{{baseUrl}}/api/fares/final"
      }
    },
    {
      "name": "Record Simulated Payment",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {"mode": "raw", "raw": "{\"rideId\":\"{{rideId}}\",\"amount\":650.00,\"method\":\"CARD\"}"},
        "url": "{{baseUrl}}/api/payments"
      }
    },
    {
      "name": "Get Payment / Receipt",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/api/payments/ride/{{rideId}}"
      }
    },
    {
      "name": "Negative - Invalid Fare",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {"mode": "raw", "raw": "{\"distanceKm\":0,\"durationMinutes\":10}"},
        "url": "{{baseUrl}}/api/fares/estimate"
      }
    }
  ]
}
